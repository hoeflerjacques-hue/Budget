<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Budget Jacques</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon.svg">
<meta name="theme-color" content="#2e7d32">
<meta name="apple-mobile-web-app-capable" content="yes">
<style>
body{font-family:sans-serif;max-width:600px;margin:auto;padding:10px;background:#f4f6f8}
h1{font-size:1.3em}.card{background:#fff;padding:10px;border-radius:8px;margin:8px 0}
input{padding:6px;font-size:1em}.row{display:flex;gap:6px;margin:4px 0}
.row input.n{flex:1}.row input.m{width:90px;text-align:right}
#reste{font-size:1.6em;font-weight:bold}button{padding:6px 10px}
</style></head><body>
<h1>Budget Jacques</h1>
<div class="card">Mois : <input type="month" id="mois">
<br><br>Salaire du mois : <input type="number" id="sal" step="0.01"> €</div>
<div class="card"><b>Dépenses du mois</b><div id="liste"></div>
<button onclick="ajout()">+ Ajouter une ligne</button></div>
<div class="card">Total dépenses : <span id="tot"></span><br>
Reste à dépenser : <span id="reste"></span></div>
<script>
const DEF=[["Loyer/Mensualité",768],["Taxe foncière",37],["Eau",27.5],["Électricité + chauffage",57.5],["Box internet",9.99],["Téléphone",7.99],["Cotisation carte",10.5],["Spotify/Deezer",10.99],["Assurance maison",13.25],["Assurance AVV",11],["Assurance voiture CM",44.02],["Prime",3.5],["Crèche",253],["Psy + Parking",110],["Courses",300],["Essence",150],["Blanche",175],["Paillette",36],["PEA (Épargne retraite)",200],["Épargne Blanche",40],["Remboursement prêt Frédéric",100]];
let db=JSON.parse(localStorage.budgetJ||"{}");
const m=document.getElementById("mois"),s=document.getElementById("sal");
m.value=new Date().toISOString().slice(0,7);
function cur(){if(!db[m.value]){const k=Object.keys(db).sort().pop();
db[m.value]=k?JSON.parse(JSON.stringify(db[k])):{sal:2700,dep:DEF.map(x=>[...x])};db[m.value].sal=k?db[k].sal:2700;}return db[m.value];}
function save(){localStorage.budgetJ=JSON.stringify(db);calc();}
function calc(){const c=cur();const t=c.dep.reduce((a,d)=>a+(+d[1]||0),0);
tot.textContent=t.toFixed(2)+" €";const r=(+c.sal||0)-t;
reste.textContent=r.toFixed(2)+" €";reste.style.color=r<0?"red":"green";}
function rendu(){const c=cur();s.value=c.sal;liste.innerHTML="";
c.dep.forEach((d,i)=>{const e=document.createElement("div");e.className="row";
e.innerHTML=`<input class="n" value="${d[0]}"><input class="m" type="number" step="0.01" value="${d[1]}"><button>✕</button>`;
const [n,v,b]=e.children;n.oninput=()=>{d[0]=n.value;save()};v.oninput=()=>{d[1]=v.value;save()};
b.onclick=()=>{c.dep.splice(i,1);save();rendu()};liste.appendChild(e)});save();}
function ajout(){cur().dep.push(["Nouvelle dépense",0]);save();rendu();}
s.oninput=()=>{cur().sal=s.value;save()};m.onchange=rendu;rendu();
</script></body></html> 
